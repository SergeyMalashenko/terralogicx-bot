# Telegram-бот TerraLogicX — токен получают у @BotFather
TELEGRAM_BOT_TOKEN=123456:placeholder

# MCP-сервер TerraLogicX (streamable-http).
# Удалённый режим: SSH-туннель до хоста engine —
#   ssh -L 8004:127.0.0.1:8004 user@terralogic-host
TERRALOGIC_MCP_URL=http://127.0.0.1:8004/mcp

# Таймаут одного MCP-вызова, секунды (сбор по новому участку идёт минуты)
TERRALOGIC_REQUEST_TIMEOUT_S=900

# Максимум одновременных формирований отчётов
MAX_CONCURRENT_REPORTS=2

# Прокси для api.telegram.org, если прямой доступ закрыт (http:// или socks5://)
TELEGRAM_PROXY=

LOG_LEVEL=INFO

# Диалог с поддержкой (см. README → «Диалог с поддержкой»).
# id служебной группы (отрицательное число); пусто = сценарий выключен,
# /support отвечает заглушкой. id появляется в логе бота при добавлении
# его в группу (строка "chat membership: chat_id=...").
SUPPORT_GROUP_ID=

# Время жизни диалога без активности, секунды
SUPPORT_SESSION_TTL_S=3600

# SQLite с сессиями и маршрутизацией ответов (переживает перезапуск)
SUPPORT_DB_PATH=data/support.sqlite3

# Бесплатные отчёты на пользователя: 0 = бесплатных нет, первый отчёт
# продаётся по промо-цене (списывается только успешно доставленный отчёт)
REPORT_LIMIT=0

# id пользователей без ограничения, через запятую (узнать свой id:
# @userinfobot); пусто = лимит действует на всех
UNLIMITED_USER_IDS=

# SQLite со счётчиками выданных отчётов (переживает перезапуск)
QUOTA_DB_PATH=data/quota.sqlite3

# Оплата пакетов отчётов через Robokassa (пустой логин = paywall без оплаты,
# только кнопка поддержки). Значения — из ЛК Robokassa → «Технические
# настройки» карточки магазина.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# 1 = тестовый режим (IsTest=1, деньги не списываются), 0 = боевой
ROBOKASSA_TEST=1

# HTTP-приёмник ResultURL-уведомлений Robokassa (авто-подтверждение оплаты).
# В тестовом режиме опрос статуса счёта невозможен — это единственный канал.
# Порт 0 = приёмник выключен. Наружу публикуется туннелем
# (например cloudflared), полученный https-URL вместе с путём
# /robokassa/result прописывается в ЛК Robokassa как ResultURL (метод POST).
ROBOKASSA_WEBHOOK_HOST=127.0.0.1
ROBOKASSA_WEBHOOK_PORT=8088

# Демо-отчёт, прикрепляемый к /start (пусто = не отправлять)
DEMO_REPORT_PATH=assets/demo-report-50-33-0010516-820.pdf

# Публичные ссылки на юридические документы — показываются в карточке
# заказа до оплаты (требование Robokassa). Публикует scripts/publish_legal_docs.py
# на telegra.ph; пусто = кнопки документов в карточке не показываются
OFFER_URL=
PRIVACY_URL=

# Версия действующей редакции оферты; пусто = извлекается из строки
# «Редакция от ДД.ММ.ГГГГ» файла OFFER_TEXT_PATH. Полный текст каждой
# редакции сохраняется в БД при запуске бота (таблица offer_versions)
OFFER_VERSION=
OFFER_TEXT_PATH=assets/TerraLogicX_Public_Offer.md

# Токен аккаунта telegra.ph для scripts/publish_legal_docs.py
# (печатается при первом запуске скрипта)
TELEGRAPH_ACCESS_TOKEN=
