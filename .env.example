# Telegram-бот TerraLogicX — токен получают у @BotFather
TELEGRAM_BOT_TOKEN=123456:placeholder

# MCP-сервер TerraLogicX (streamable-http).
# Удалённый режим: SSH-туннель до хоста engine —
#   ssh -L 8004:127.0.0.1:8004 user@terralogic-host
TERRALOGIC_MCP_URL=http://127.0.0.1:8004/mcp

# Таймаут одного MCP-вызова, секунды (сбор по новому участку идёт минуты)
TERRALOGIC_REQUEST_TIMEOUT_S=900

# Максимум одновременных формирований отчётов
MAX_CONCURRENT_REPORTS=2

# Прокси для api.telegram.org, если прямой доступ закрыт (http:// или socks5://)
TELEGRAM_PROXY=

LOG_LEVEL=INFO

# Диалог с поддержкой (см. README → «Диалог с поддержкой»).
# id служебной группы (отрицательное число); пусто = сценарий выключен,
# /support отвечает заглушкой. id появляется в логе бота при добавлении
# его в группу (строка "chat membership: chat_id=...").
SUPPORT_GROUP_ID=

# Время жизни диалога без активности, секунды
SUPPORT_SESSION_TTL_S=3600

# SQLite с сессиями и маршрутизацией ответов (переживает перезапуск)
SUPPORT_DB_PATH=data/support.sqlite3

# Квота на отчёты: сколько PDF может получить обычный пользователь
# (списывается только успешно доставленный отчёт)
REPORT_LIMIT=5

# id пользователей без ограничения, через запятую (узнать свой id:
# @userinfobot); пусто = лимит действует на всех
UNLIMITED_USER_IDS=

# SQLite со счётчиками выданных отчётов (переживает перезапуск)
QUOTA_DB_PATH=data/quota.sqlite3
