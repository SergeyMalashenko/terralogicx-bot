# Telegram-бот TerraLogicX — токен получают у @BotFather
TELEGRAM_BOT_TOKEN=123456:placeholder

# MCP-сервер TerraLogicX (streamable-http).
# Удалённый режим: SSH-туннель до хоста engine —
#   ssh -L 8004:127.0.0.1:8004 user@terralogic-host
TERRALOGIC_MCP_URL=http://127.0.0.1:8004/mcp

# Таймаут одного MCP-вызова, секунды (сбор по новому участку идёт минуты)
TERRALOGIC_REQUEST_TIMEOUT_S=900

# Максимум одновременных формирований отчётов
MAX_CONCURRENT_REPORTS=2

# Прокси для api.telegram.org, если прямой доступ закрыт (http:// или socks5://)
TELEGRAM_PROXY=

LOG_LEVEL=INFO
